# Copiar como .env.local para ejecutar Next.js contra Supabase local.
# El stack local usa la banda 55320-55329 (ver supabase/config.toml): Windows
# reserva el rango TCP 54234-54333, que contenía los puertos por defecto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-from-supabase-status

# Server only. Never expose this with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status

NEXT_PUBLIC_SITE_URL=http://localhost:3000
CATALOG_DEFAULT_WHATSAPP=+51963463550

# Cargador XLSX interno. Mantener en false salvo cuando un developer vaya a usarlo.
ENABLE_CATALOG_IMPORTS=false

# Solo desarrollo local del PDF (opcional). En serverless (Vercel) se usa
# @sparticuz/chromium automáticamente. En local, el generador usa el Chromium del paquete
# `puppeteer`; si no está descargado, ejecuta `npx puppeteer browsers install chrome` o
# apunta aquí un Chrome/Edge del sistema, p. ej.:
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
