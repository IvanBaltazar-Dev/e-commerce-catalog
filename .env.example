# Copiar como .env.local para ejecutar Next.js contra Supabase local.
# El stack local usa la banda 55320-55329 (ver supabase/config.toml): Windows
# reserva el rango TCP 54234-54333, que contenía los puertos por defecto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-from-supabase-status

# Server only. Never expose this with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status

NEXT_PUBLIC_SITE_URL=http://localhost:3000
CATALOG_DEFAULT_WHATSAPP=+51963463550

# Cargador XLSX interno. Mantener en false salvo cuando un developer vaya a usarlo.
ENABLE_CATALOG_IMPORTS=false

# Almacenamiento administrado de investigación. Si se omite, usa
# research/catalog-master dentro del repo, cuyas carpetas pesadas están ignoradas.
# Puede apuntar a otro disco sin cambiar los contratos.
# CATALOG_RESEARCH_STORAGE_ROOT=D:/bellaroshe-catalog-research
# CATALOG_CHECKPOINT_DATA_SQL=D:/ruta-segura/pre-reset-20260810-0359-datos.sql
# CATALOG_SOURCE_WORKBOOK=<storage-root>/local/inputs/Listado_organizado_productos_Bellaroshe.xlsx
# CATALOG_SOURCE_JSON=<storage-root>/local/inputs/source-workbook.json
# CATALOG_MASGLO_MANIFEST=<storage-root>/local/inputs/masglo/MANIFIESTO_IMAGENES.csv
# CATALOG_MASGLO_CURATED_WORKBOOK=<storage-root>/local/inputs/masglo/plantilla_masglo.xlsx
# CATALOG_MASGLO_SWATCH_DIR=<storage-root>/local/inputs/masglo/tonos
# CATALOG_ASSET_SOURCE_DIR=<storage-root>/local/inputs/catalogo
# CATALOG_SNAPSHOT_CUTOFF=YYYY-MM-DD
# ARTIFACT_TOOL_ENTRY=file:///ruta/instalada/artifact_tool.mjs

# Solo desarrollo local del PDF (opcional). En serverless (Vercel) se usa
# @sparticuz/chromium automáticamente. En local, el generador usa el Chromium del paquete
# `puppeteer`; si no está descargado, ejecuta `npx puppeteer browsers install chrome` o
# apunta aquí un Chrome/Edge del sistema, p. ej.:
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

# Guiones de prueba de UI y gate de reconstrucción: contra qué servidor corren.
# Por omisión el build de producción local (npm run start -- -p 3002).
# UI_BASE_URL=http://localhost:3002

# Nota: los guiones .mjs leen `.env.supabase.local` (generado con las claves de
# `npx supabase status`) — mismo formato que este archivo, solo claves locales.

# --- Bloque 3 · Integraciones omnicanal -------------------------------------
# SECRETOS DE SERVIDOR: sin prefijo NEXT_PUBLIC_ jamás, y nunca en la base.
# Sin credenciales, los adaptadores degradan a modo local: los webhooks se
# registran igual y los mensajes salientes quedan en cola visible.

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Messenger / Instagram (Meta)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# TikTok (limitado: sin mensajería por API; atribución por UTM/QR)
TIKTOK_WEBHOOK_SECRET=

# Asistencia IA del Bloque 4 (opcional a propósito, regla 10: sin credencial
# el intérprete y el asesor degradan al camino determinista, la visión
# responde «no disponible» y la operación manual sigue intacta).
# Solo de servidor: JAMÁS con prefijo NEXT_PUBLIC_ ni en el cliente.
ANTHROPIC_API_KEY=
