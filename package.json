  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@sparticuz/chromium": "148.0.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "next": "^15.2.4",
    "pdfkit": "^0.16.0",
    "puppeteer-core": "24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
