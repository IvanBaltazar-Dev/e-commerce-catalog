{
  "name": "bellaroshe-catalog-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "prototype": "npm run prototype:build && npm run prototype:start",
    "prototype:build": "node scripts/build-prototype.mjs",
    "prototype:start": "node scripts/serve-prototype.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:reset:local": "supabase db reset --local",
    "test:db": "supabase test db --local",
    "test:backfill": "powershell -ExecutionPolicy Bypass -File scripts/test-v1-backfill.ps1",
    "test:contracts": "node scripts/test-v2-contracts.mjs --env .env.supabase.local",
    "test:admin-flow": "node scripts/test-v2-admin-flow.mjs --env .env.supabase.local",
    "test:product-registration": "node scripts/test-product-registration-ui.mjs --env .env.supabase.local",
    "test:scale": "node scripts/test-v2-scale.mjs --env .env.supabase.local",
    "test:catalog-import-xlsx": "node --conditions=react-server --experimental-transform-types scripts/test-catalog-import-xlsx.mjs",
    "test:catalog-media-zip": "node --conditions=react-server --experimental-transform-types scripts/test-catalog-media-zip.mjs",
    "test:catalog-media-flow": "node --conditions=react-server --experimental-transform-types scripts/test-catalog-media-flow.mjs --env .env.supabase.local",
    "test:catalog-import-flow": "node --conditions=react-server --experimental-transform-types scripts/test-catalog-import-flow.mjs --env .env.supabase.local",
    "test:catalog-import-access": "node scripts/test-catalog-import-access.mjs --env .env.supabase.local",
    "test:relation-recommendations": "node --experimental-transform-types scripts/test-relation-recommendations.mjs",
    "test:relation-context": "node --experimental-transform-types scripts/test-relation-context.mjs",
    "test:inventory-concurrency": "node scripts/test-inventory-concurrency.mjs",
    "test:sales-concurrency": "node scripts/test-sales-concurrency.mjs",
    "test:settle-concurrency": "node scripts/test-settle-concurrency.mjs",
    "test:payment-rule": "node --experimental-transform-types scripts/test-payment-rule.mjs",
    "test:sale-note": "node scripts/test-sale-note.mjs --env .env.supabase.local",
    "test:venta": "npm run test:payment-rule && npm run test:settle-concurrency && npm run test:sales-concurrency && npm run test:sale-note",
    "test:sales-ui": "node scripts/test-sales-ui.mjs --env .env.supabase.local",
    "test:block2": "node scripts/test-block2-integral.mjs --env .env.supabase.local",
    "test:block3": "node scripts/test-block3-integral.mjs --env .env.supabase.local",
    "test:omnichannel-concurrency": "node scripts/test-omnichannel-concurrency.mjs",
    "test:ai-matching": "node scripts/test-ai-matching.mjs",
    "test:block4": "node scripts/test-block4-intelligence.mjs",
    "gate:rebuild": "node scripts/gate-rebuild.mjs",
    "gate:selectors": "node scripts/gate-selectors.mjs",
    "shoot:surfaces": "node scripts/shoot-surfaces.mjs",
    "seed:demo-operation": "node scripts/seed-demo-operation.mjs --env .env.supabase.local",
    "test:cleanup": "node scripts/cleanup-v2-test-data.mjs --env .env.supabase.local",
    "audit:security": "node scripts/audit-security.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "perf:volume": "node scripts/perf-volume.mjs",
    "test:responsive": "node scripts/test-responsive-sweep.mjs",
    "test:tone-picker": "node scripts/test-tone-picker.mjs",
    "rollback:drill": "node scripts/rollback-drill.mjs",
    "e2e:staging": "node scripts/e2e-staging.mjs",
    "test:bulk-import-pilot": "node --conditions=react-server --experimental-transform-types scripts/test-bulk-import-pilot.mjs --env .env.supabase.local",
    "dev:b": "node scripts/dev-b.mjs",
    "dev:c": "node scripts/dev-c.mjs",
    "dev:d": "node scripts/dev-d.mjs",
    "build:a": "node scripts/build-a.mjs",
    "serve:a": "node scripts/serve-a.mjs",
    "bulk:lote": "node --conditions=react-server --experimental-transform-types scripts/run-bulk-lote.mjs --env .env.supabase.local",
    "audit:catalog-real": "node --conditions=react-server --experimental-transform-types scripts/audit-catalog-real.mjs --env .env.supabase.local",
    "gate:busqueda": "node scripts/gate-busqueda.mjs",
    "catalog:enrichment:stage": "node scripts/catalog-enrichment-stage.mjs --env .env.supabase.local",
    "catalog:storage:verify": "node research/catalog-master/verify-local-storage.mjs",
    "checkpoint:restore:local": "node scripts/checkpoint-restore-local.mjs",
    "test:catalog-review-rerun": "node scripts/test-catalog-review-rerun.mjs --env .env.supabase.local",
    "gate:enriquecimiento": "node scripts/gate-enriquecimiento.mjs --env .env.supabase.local",
    "test:admin-search": "node scripts/test-admin-search-contracts.mjs",
    "test:admin-nav": "node scripts/check-nav.mjs",
    "neo4j:up": "docker compose --env-file .env.supabase.local -f infra/neo4j/compose.yml up -d --wait",
    "neo4j:down": "docker compose --env-file .env.supabase.local -f infra/neo4j/compose.yml down",
    "graph:status": "node --experimental-transform-types scripts/graph-projector.mjs status --env .env.supabase.local",
    "graph:sync": "node --experimental-transform-types scripts/graph-projector.mjs sync --env .env.supabase.local",
    "graph:verify": "node --experimental-transform-types scripts/graph-projector.mjs verify --env .env.supabase.local",
    "graph:rebuild": "node --experimental-transform-types scripts/graph-projector.mjs rebuild --env .env.supabase.local",
    "stage1:fixtures": "node scripts/seed-stage1-reference-fixtures.mjs --env .env.supabase.local",
    "test:graph-projector": "node --experimental-transform-types scripts/test-graph-projector.mjs --env .env.supabase.local",
    "gate:reference-scale": "node scripts/gate-reference-scale.mjs --env .env.supabase.local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@sparticuz/chromium": "148.0.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "neo4j-driver": "^5.28.3",
    "next": "^15.2.4",
    "pdfkit": "^0.16.0",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "puppeteer-core": "24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "puppeteer": "24.43.1",
    "supabase": "^2.109.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "$sharp"
  },
  "allowScripts": {
    "puppeteer@24.43.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
